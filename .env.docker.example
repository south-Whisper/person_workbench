# 复制为 .env.docker 后再填写。不要把真实密码提交到代码仓库。
DOCKER_REGISTRY=docker.m.daocloud.io/library
SETHUB_HTTP_PORT=80
SETHUB_PUBLIC_ORIGIN=http://服务器IP或域名
SETHUB_DB_PASSWORD=请改成至少32位随机密码
SETHUB_DB_ROOT_PASSWORD=请改成另一条至少32位随机密码
SETHUB_JWT_SECRET=请改成至少32位且与数据库密码不同的随机字符串
# 发放 Offer 使用的发件邮箱。PASSWORD 填邮箱服务商生成的 SMTP 授权码，不是网页登录密码。
SETHUB_MAIL_HOST=smtp.qq.com
SETHUB_MAIL_PORT=465
SETHUB_MAIL_USERNAME=你的发件邮箱@qq.com
SETHUB_MAIL_PASSWORD=邮箱SMTP授权码
SETHUB_MAIL_FROM=你的发件邮箱@qq.com
SETHUB_MAIL_SSL=true
SETHUB_MAIL_STARTTLS=false
